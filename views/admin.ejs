<!doctype html><html><head><title>Nova Studio Admin</title><link rel="stylesheet" href="/style.css"></head><body><header class="top"><div class="brand">Nova Studio <span class="heart">♡</span></div><form method="post" action="/admin/logout"><button class="btn">Logout</button></form></header><main class="adminwrap"><h1 style="font-family:'Playfair Display';font-weight:400;font-size:48px">Customers</h1><div class="panel"><h2>Create a customer</h2><form method="post" action="/admin/clients"><div class="formgrid"><input class="input" name="name" placeholder="Customer / couple name" required><input class="input" name="username" placeholder="Login username" required><input class="input" name="password" placeholder="Temporary password" minlength="6" required></div><br><button class="btn dark">+ Create customer</button></form></div><div class="panel"><h2>Your customers</h2><% if(!clients.length){%><p class="small">No customers yet.</p><%}%><% clients.forEach(c=>{%><div class="clientrow"><div><strong><%=c.name%></strong><div class="small">@<%=c.username%> · <a href="/open/<%=c.slug%>" target="_blank">/open/<%=c.slug%></a></div></div><div><a class="btn" href="/open/<%=c.slug%>" target="_blank">View</a> <form style="display:inline" method="post" action="/admin/clients/<%=c.id%>/delete" onsubmit="return confirm('Delete this customer?')"><button class="btn danger">Delete</button></form></div></div><%})%></div></main></body></html>