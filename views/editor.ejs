<!doctype html><html><head><title>Edit my Open When</title><link rel="stylesheet" href="/style.css"></head><body>
<nav class="editor-nav"><div class="brand">open when <span class="heart">♡</span></div><div><a class="btn" href="/open/<%=client.slug%>" target="_blank">Preview my site</a> <form style="display:inline" method="post" action="/logout"><button class="btn">Logout</button></form></div></nav>
<main class="editor"><h1 style="font-family:'Playfair Display';font-size:48px;font-weight:400">Customize your Open When</h1><p class="small">Everything here belongs only to you. Add as many letters and photos as you want.</p>
<% if(query && query.saved){%><div class="success">Saved successfully ♡</div><%}%>
<form class="panel" method="post" action="/editor/settings" enctype="multipart/form-data"><h2>Home & theme</h2><div class="two"><div><label>Theme</label><select class="select" name="theme"><option value="burgundy" <%=settings.theme==='burgundy'?'selected':''%>>Burgundy & cream</option><option value="rose" <%=settings.theme==='rose'?'selected':''%>>Soft rose</option><option value="midnight" <%=settings.theme==='midnight'?'selected':''%>>Midnight</option><option value="sage" <%=settings.theme==='sage'?'selected':''%>>Sage</option></select><br><br><label>Home photo</label><input class="fileinput" type="file" name="home_photo" accept="image/*"></div><div><label>Song file (MP3 / WAV / M4A)</label><input class="fileinput" type="file" name="song_file" accept="audio/*"><br><br><label>Or song URL</label><input class="input" name="song_url" value="<%=settings.song_url%>" placeholder="https://..."><br><br><label>Recipient</label><input class="input" name="recipient" value="<%=settings.recipient%>"><br><br><label>From</label><input class="input" name="sender" value="<%=settings.sender%>"></div></div><br><input class="input" name="intro_title" value="<%=settings.intro_title%>"><br><br><input class="input" name="intro_subtitle" value="<%=settings.intro_subtitle%>"><br><br><textarea class="textarea" name="intro_text"><%=settings.intro_text%></textarea><br><br><button class="btn dark">Save home</button></form>
<div class="panel"><h2>Letters</h2><form method="post" action="/editor/letters/add"><div class="formgrid"><input class="input" name="title" placeholder="New letter title" required><input class="input" name="icon" value="♡" placeholder="Icon"></div><br><button class="btn dark">+ Add another letter</button></form></div>
<% letters.forEach((l,i)=>{%><form class="letter-edit" method="post" action="/editor/letters/<%=l.id%>/save" enctype="multipart/form-data"><div style="display:flex;justify-content:space-between"><h2><%=String(i+1).padStart(2,'0')%> · <%=l.title%></h2><button class="btn danger" type="submit" formaction="/editor/letters/<%=l.id%>/delete" onclick="return confirm('Delete this letter?')">Delete</button></div><div class="two"><div><input class="input" name="title" value="<%=l.title%>"><br><br><input class="input" name="icon" value="<%=l.icon%>"><br><br><textarea class="textarea" name="body" placeholder="Write your letter here..."><%=l.body%></textarea></div><div><label>Add photos to this letter (add as many as you want)</label><input class="fileinput" type="file" name="photos" accept="image/*" multiple><br><br><label><input type="checkbox" name="use_first_as_cover"> Use first new photo as cover</label><% if(l.photos.length){%><div class="photo-row"><% l.photos.forEach(p=>{%><img src="<%=p.file_path%>"><%})%></div><%}%></div></div><br><button class="btn dark">Save this letter</button></form><%})%>
</main></body></html>