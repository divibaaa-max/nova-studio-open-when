<!doctype html><html><head><title><%=settings.intro_title%></title><link rel="stylesheet" href="/style.css"></head><body class="theme-<%=settings.theme || 'burgundy'%>">
<header class="top"><div class="brand">open when <span class="heart">♡</span></div><div><span class="small"><%=settings.recipient%></span></div></header>
<section class="hero" style="<%=settings.home_photo?'background-image:linear-gradient(90deg,rgba(45,18,25,.94),rgba(70,24,37,.72)),url('+settings.home_photo+')':''%>"><div class="hero-inner"><div class="eyebrow">A collection of little moments</div><h1><%=settings.intro_title%></h1><div class="script"><%=settings.intro_subtitle%></div><p><%=settings.intro_text%></p><button class="btn" onclick="document.getElementById('letters').scrollIntoView({behavior:'smooth'})">Start opening ↗</button><div class="signature"><span>FOR <b><%=settings.recipient%></b></span><span>FROM <b><%=settings.sender%></b></span></div></div></section>
<section class="section" id="letters"><div class="section-title">A letter for every feeling.</div><div class="grid"><% letters.forEach((l,i)=>{%><article class="card"><div class="num"><%=String(i+1).padStart(2,'0')%></div><div class="card-center"><div class="icon"><%=l.icon%></div><div class="openwhen">Open when...</div><h3><%=l.title%></h3><div class="envelope">♡</div><div class="small">♡ click to open</div><div class="letter-body"><div style="white-space:pre-wrap"><%=l.body%></div><% if(l.photos.length){%><div class="photo-row"><%l.photos.forEach(p=>{%><img src="<%=p.file_path%>"><%})%></div><%}%></div></div></article><%})%></div></section>
<section class="section dark"><div class="quote">“There is a letter for every feeling.<br>And love in every single one.”<div class="allura">Always, <%=settings.sender%> ♡</div></div></section>
<% if(settings.song_url || settings.song_file){%><audio id="song" src="<%=settings.song_file || settings.song_url%>" loop></audio><button class="btn dark" style="position:fixed;right:20px;bottom:20px" onclick="document.getElementById('song').play()">♫ Play our song</button><%}%>
<script>document.querySelectorAll('.card').forEach(c=>c.addEventListener('click',e=>{if(e.target.closest('button')||e.target.tagName==='IMG')return;c.classList.toggle('open')}));</script>
</body></html>